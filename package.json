{
  "name": "repo-size",
  "version": "0.1.0",
  "description": "Terminal UI to scan folders and track file count / lines-of-code trends over time",
  "type": "module",
  "bin": {
    "repo-size": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
