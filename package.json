  },
  "dependencies": {
    "asciichart": "^1.5.25",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/node": "^20.14.9",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
